---
# Keystone Webhook Auth — Host Static Pod
# hostNetwork=true로 호스트 :8443 바인드. apiserver는 같은 호스트의 127.0.0.1:8443으로 호출.
# kubelet이 apiserver/DNS 의존 없이 직접 띄움 (8.14 데드락 해소).
apiVersion: v1
kind: Pod
metadata:
  name: k8s-keystone-auth
  namespace: kube-system
  labels:
    app: k8s-keystone-auth
    component: auth-webhook
spec:
  hostNetwork: true
  priorityClassName: system-node-critical
  containers:
    - name: k8s-keystone-auth
      image: {{ keystone_auth_image }}
      args:
        - /bin/k8s-keystone-auth
        - --tls-cert-file=/etc/pki/tls.crt
        - --tls-private-key-file=/etc/pki/tls.key
        - --keystone-url={{ os_auth_url }}
        - --keystone-policy-file=/etc/policy/policy.json
        - --listen=127.0.0.1:8443
      imagePullPolicy: IfNotPresent
      ports:
        - containerPort: 8443
          name: https
      volumeMounts:
        - name: certs
          mountPath: /etc/pki
          readOnly: true
        - name: policy
          mountPath: /etc/policy
          readOnly: true
  volumes:
    - name: certs
      hostPath:
        path: /etc/kubernetes/keystone-auth
        type: Directory
    - name: policy
      hostPath:
        path: /etc/kubernetes/keystone-auth
        type: Directory
