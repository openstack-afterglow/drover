#!/bin/bash
# New Drover guests call the Drover public callback endpoint directly.
set -e
export PATH="/usr/local/bin:$PATH"
CALLBACK_URL="{{ callback_url }}"
CALLBACK_TOKEN="{{ callback_token }}"
PIN_ENV="/etc/rancher/k3s/afterglow-primary-network.env"
if [ ! -r "${PIN_ENV}" ] || ! . "${PIN_ENV}" 2>/dev/null || \
    [[ ! "${AFTERGLOW_K3S_NODE_IP:-}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || \
    [[ ! "${AFTERGLOW_K3S_PRIMARY_IFACE:-}" =~ ^[A-Za-z0-9_.:-]{1,15}$ ]]; then
  echo "[k3s-callback] ERROR: primary network pin missing" | tee -a /var/log/k3s-callback.log
  curl -sf -X POST "${CALLBACK_URL}/v1/callback" \
    -H "Content-Type: application/json" \
    -d "{\"token\": \"${CALLBACK_TOKEN}\", \"success\": false, \"error\": \"primary network pin missing\"}" || true
  exit 1
fi

log() { echo "[k3s-callback] $*" | tee -a /var/log/k3s-callback.log; }

log "Waiting for k3s kubeconfig (up to 10 min)..."
for i in $(seq 1 120); do
  if [ -f /etc/rancher/k3s/k3s.yaml ]; then
    break
  fi
  sleep 5
done

if [ ! -f /etc/rancher/k3s/k3s.yaml ]; then
  log "ERROR: kubeconfig not found after 10 minutes"
  curl -sf -X POST "${CALLBACK_URL}/v1/callback" \
    -H "Content-Type: application/json" \
    -d "{\"token\": \"${CALLBACK_TOKEN}\", \"success\": false, \"error\": \"kubeconfig not found after 10min\"}" || true
  exit 1
fi

# /livez 는 k8s 1.34부터 익명 요청에 401을 반환 — admin kubeconfig로 인증된 체크 사용
log "Waiting for kube-apiserver /livez (up to 10 min)..."
APISERVER_READY=0
for i in $(seq 1 120); do
  if kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml --request-timeout=3s \
      get --raw='/livez' >/dev/null 2>&1; then
    APISERVER_READY=1
    break
  fi
  sleep 5
done
if [ "${APISERVER_READY}" -ne 1 ]; then
  log "ERROR: kube-apiserver /livez did not return OK after 10 min"
  curl -sf -X POST "${CALLBACK_URL}/v1/callback" \
    -H "Content-Type: application/json" \
    -d "{\"token\": \"${CALLBACK_TOKEN}\", \"success\": false, \"error\": \"kube-apiserver not ready after 10min\"}" || true
  exit 1
fi
log "kube-apiserver is ready"

# k3s 재시작 루프 감지 — NRestarts 카운터로 비정상 재시작 여부 판단
K3S_RESTARTS=$(systemctl show k3s.service -p NRestarts --value 2>/dev/null || echo "0")
RESTART_THRESHOLD=5
if [ "${K3S_RESTARTS}" -ge "${RESTART_THRESHOLD}" ]; then
  log "ERROR: k3s가 ${K3S_RESTARTS}회 재시작됨 — 재시작 루프 감지 (임계: ${RESTART_THRESHOLD})"
  curl -sf -X POST "${CALLBACK_URL}/v1/callback" \
    -H "Content-Type: application/json" \
    -d "{\"token\": \"${CALLBACK_TOKEN}\", \"success\": false, \"error\": \"k3s restart loop detected (${K3S_RESTARTS} restarts, threshold=${RESTART_THRESHOLD})\"}" || true
  exit 1
fi
log "k3s restart count: ${K3S_RESTARTS} (threshold: ${RESTART_THRESHOLD}) — OK"

log "Waiting for node-token (up to 5 min)..."
for i in $(seq 1 60); do
  if [ -f /var/lib/rancher/k3s/server/node-token ]; then
    break
  fi
  sleep 5
done

{% if cloud_conf %}
# cloud-config secret 생성 (플러그인 공통 1회)
log "Creating cloud-config secret..."
SECRET_CLOUD_CONFIG_STATUS="ok"
if ! kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml \
    create secret -n kube-system generic cloud-config \
    --from-file=cloud.conf=/etc/kubernetes/cloud.conf >> /var/log/k3s-callback.log 2>&1; then
  SECRET_CLOUD_CONFIG_STATUS="failed"
  log "WARNING: cloud-config secret 생성 실패 — OCCM이 시작되지 않을 수 있습니다"
fi

{% endif %}
{% for plugin in plugins %}
# 플러그인 배포: {{ plugin.name }}
PLUGIN_{{ plugin.name | upper }}_STATUS="not_deployed"
PLUGIN_{{ plugin.name | upper }}_ERROR=""
log "Deploying plugin: {{ plugin.name }}..."
_ERR_FILE="/var/log/k3s-callback-{{ plugin.name }}.stderr"
if kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml \
    apply --validate=false -f /opt/k3s/{{ plugin.name }}-manifests.yaml \
    >> /var/log/k3s-callback.log 2>"${_ERR_FILE}"; then
  PLUGIN_{{ plugin.name | upper }}_STATUS="deployed"
  log "Plugin {{ plugin.name }} deployed successfully"
else
  PLUGIN_{{ plugin.name | upper }}_STATUS="failed"
  PLUGIN_{{ plugin.name | upper }}_ERROR="$(tail -c 1024 "${_ERR_FILE}" | tr '\n' ' ' | sed 's/"/\\"/g')"
  log "ERROR: Plugin {{ plugin.name }} deployment failed — see ${_ERR_FILE}"
fi

{% endfor %}
SERVER_IP="${AFTERGLOW_K3S_NODE_IP}"
KUBECONFIG_RAW=$(cat /etc/rancher/k3s/k3s.yaml)
# 127.0.0.1 → 실제 서버 IP로 치환
KUBECONFIG_FIXED=$(echo "${KUBECONFIG_RAW}" | sed "s/127\.0\.0\.1/${SERVER_IP}/g")
NODE_TOKEN=$(cat /var/lib/rancher/k3s/server/node-token 2>/dev/null || echo "")

log "Sending callback to ${CALLBACK_URL}"
PLUGIN_STATUS_JSON=$(jq -n \
{% for plugin in plugins %}
  --arg {{ plugin.name }}_st "${PLUGIN_{{ plugin.name | upper }}_STATUS}" \
  --arg {{ plugin.name }}_er "${PLUGIN_{{ plugin.name | upper }}_ERROR}" \
{% endfor %}
{% if plugins %}
  '{ {% for plugin in plugins %}{{ '"' ~ plugin.name ~ '"' }}: {status: ${{ plugin.name }}_st, error: ${{ plugin.name }}_er}{% if not loop.last %}, {% endif %}{% endfor %} }')
{% else %}
  '{}')
{% endif %}

PAYLOAD=$(jq -n \
  --arg token   "${CALLBACK_TOKEN}" \
  --arg kc      "${KUBECONFIG_FIXED}" \
  --arg nt      "${NODE_TOKEN}" \
  --arg sip     "${SERVER_IP}" \
  --argjson ps  "${PLUGIN_STATUS_JSON}" \
  --arg scs     "${SECRET_CLOUD_CONFIG_STATUS:-}" \
  '{token: $token, success: true, kubeconfig: $kc, node_token: $nt, server_ip: $sip, plugin_status: $ps, secret_cloud_config_status: ($scs | if . == "" then null else . end)}')

log "Payload size: $(echo -n "${PAYLOAD}" | wc -c) bytes"
HTTP_CODE=$(curl -s -o /tmp/callback_response.txt -w "%{http_code}" \
  -X POST "${CALLBACK_URL}/v1/callback" \
  -H "Content-Type: application/json" \
  -d "${PAYLOAD}" --connect-timeout 10 --max-time 30 2>&1) || true
RESPONSE=$(cat /tmp/callback_response.txt 2>/dev/null || echo "")
if [ "${HTTP_CODE}" = "200" ]; then
  log "Callback sent successfully (HTTP ${HTTP_CODE})"
else
  log "ERROR: Callback failed (HTTP ${HTTP_CODE}): ${RESPONSE}"
  sleep 30
  log "Retrying callback..."
  curl -s -o /dev/null -w "Retry HTTP %{http_code}\n" \
    -X POST "${CALLBACK_URL}/v1/callback" \
    -H "Content-Type: application/json" \
    -d "${PAYLOAD}" --connect-timeout 10 --max-time 30 >> /var/log/k3s-callback.log 2>&1 || true
fi
