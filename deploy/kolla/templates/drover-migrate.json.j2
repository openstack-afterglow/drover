{
    "command": "drover-migrate",
    "config_files": [
        {
            "source": "/var/lib/kolla/config_files/drover.conf",
            "dest": "/etc/drover/drover.conf",
            "owner": "appuser",
            "perm": "0600"
        }
    ],
    "permissions": [
        {
            "path": "/var/log/kolla/drover",
            "owner": "appuser:appuser",
            "recurse": true
        }
    ]
}
