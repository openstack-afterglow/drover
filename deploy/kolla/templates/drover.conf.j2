# Drover Service Configuration
# Generated by Kolla-Ansible for {{ ansible_hostname | default('host') }}

[openstack]
auth_url = "{{ drover_keystone_auth_url }}"
username = "{{ drover_keystone_username }}"
password_file = "{{ drover_keystone_password_file | default('/etc/drover/secrets/os_password') }}"
project_name = "{{ drover_keystone_project_name }}"
project_domain_name = "{{ drover_keystone_project_domain_name }}"
user_domain_name = "{{ drover_keystone_user_domain_name }}"
region = "{{ drover_keystone_region }}"
interface = "{{ drover_keystone_interface }}"
insecure = {{ drover_keystone_insecure | lower }}
cacert = "{{ drover_openstack_cacert }}"
service_project_id = "{{ drover_service_project_id }}"
admin_legacy_project_policy = {{ drover_admin_legacy_project_policy | lower }}

[database]
url = "{{ drover_database_url }}"
password_file = "{{ drover_database_password_file | default('/etc/drover/secrets/database_password') }}"
pool_size = {{ drover_database_pool_size | default(5) }}
max_overflow = {{ drover_database_max_overflow | default(10) }}
connect_timeout = {{ drover_database_connect_timeout | default(10) }}
pool_timeout = {{ drover_database_pool_timeout | default(10) }}

[cache]
redis_url = "{{ drover_redis_url }}"
password_file = "{{ drover_redis_password_file | default('/etc/drover/secrets/redis_password') }}"

[drover]
callback_base_url = "{{ drover_callback_base_url }}"
policy_file = "{{ drover_policy_file | default('/etc/drover/policy.yaml') }}"
kubeconfig_encryption_key_file = "{{ drover_kubeconfig_encryption_key_file | default('/etc/drover/secrets/kubeconfig_encryption_key') }}"
boot_volume_size_gb = {{ drover_boot_volume_size_gb | default(30) }}
occm_enabled = {{ drover_occm_enabled | lower }}
cinder_csi_enabled = {{ drover_cinder_csi_enabled | lower }}
manila_csi_enabled = {{ drover_manila_csi_enabled | lower }}
k3s_health_interval = {{ drover_k3s_health_interval | default(180) }}
callback_allowed_cidrs = "{{ drover_callback_allowed_cidrs | join(',') if drover_callback_allowed_cidrs is iterable and drover_callback_allowed_cidrs is not string else drover_callback_allowed_cidrs }}"
