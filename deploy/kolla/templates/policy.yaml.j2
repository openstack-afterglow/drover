# Drover Oslo Policy rules
# Generated by Kolla-Ansible for {{ ansible_hostname | default('host') }}

"context_is_admin": "role:admin or is_system_admin:True"
"owner": "project_id:%(project_id)s"
"admin_or_owner": "rule:context_is_admin or rule:owner"

"drover:clusters:get": "rule:admin_or_owner"
"drover:clusters:create": "rule:admin_or_owner"
"drover:clusters:delete": "rule:admin_or_owner"
"drover:clusters:scale": "rule:admin_or_owner"

"drover:templates:manage": "rule:context_is_admin"

"drover:operations:get": "rule:admin_or_owner"

"drover:admin": "rule:context_is_admin"

{% if drover_policy_overrides is defined and drover_policy_overrides %}
{% if drover_policy_overrides is string %}
{{ drover_policy_overrides }}
{% else %}
{% for rule_name, rule_value in drover_policy_overrides.items() %}
"{{ rule_name }}": "{{ rule_value }}"
{% endfor %}
{% endif %}
{% endif %}
