# Drover configuration generated by kolla-ansible

[keystone]
auth_url = "{{ drover_keystone_auth_url }}"
username = "{{ drover_keystone_user }}"
password_file = "{{ drover_keystone_password_file }}"
project_name = "{{ drover_service_project_name }}"
service_project_id = "{{ drover_service_project_id }}"
project_domain_name = "{{ drover_keystone_project_domain_name }}"
user_domain_name = "{{ drover_keystone_user_domain_name }}"
region = "{{ drover_keystone_region_name }}"
interface = "{{ drover_keystone_interface }}"
insecure = {{ openstack_insecure | default(false) | bool | lower }}
cacert = "{{ openstack_cacert | default('') }}"

[database]
url = "{{ drover_database_url }}"
password_file = "{{ drover_database_password_file }}"
pool_size = 5
max_overflow = 10
connect_timeout = 10
pool_timeout = 10

[cache]
redis_url = "{{ drover_redis_url }}"
password_file = "{{ drover_redis_password_file }}"

[drover]
callback_base_url = "{{ drover_callback_base_url }}"
kubeconfig_encryption_key_file = "{{ drover_kubeconfig_encryption_key_file }}"
boot_volume_size_gb = {{ drover_boot_volume_size_gb }}
occm_enabled = {{ drover_occm_enabled | bool | lower }}
occm_image = "{{ drover_occm_image }}"
cinder_csi_enabled = {{ drover_cinder_csi_enabled | bool | lower }}
cinder_csi_image = "{{ drover_cinder_csi_image }}"
manila_csi_enabled = {{ drover_manila_csi_enabled | bool | lower }}
manila_csi_image = "{{ drover_manila_csi_image }}"
manila_csi_nfs_image = "{{ drover_manila_csi_nfs_image }}"
manila_csi_share_protocol = "{{ drover_manila_csi_share_protocol }}"
keystone_auth_enabled = {{ drover_keystone_auth_enabled | bool | lower }}
keystone_auth_image = "{{ drover_keystone_auth_image }}"
keystone_auth_policy = "{{ drover_keystone_auth_policy }}"
octavia_ingress_enabled = {{ drover_octavia_ingress_enabled | bool | lower }}
octavia_ingress_image = "{{ drover_octavia_ingress_image }}"
barbican_kms_enabled = {{ drover_barbican_kms_enabled | bool | lower }}
barbican_kms_image = "{{ drover_barbican_kms_image }}"
barbican_kms_kek_id = "{{ drover_barbican_kms_kek_id }}"
cert_rotation_node_timeout_sec = {{ drover_cert_rotation_node_timeout_sec }}
cert_rotation_job_image = "{{ drover_cert_rotation_job_image }}"
stampede_enabled = {{ drover_stampede_enabled | bool | lower }}
stampede_interval = {{ drover_stampede_interval }}
stampede_scale_down_threshold = {{ drover_stampede_scale_down_threshold }}
stampede_scale_down_window = {{ drover_stampede_scale_down_window }}
stampede_scale_up_cooldown = {{ drover_stampede_scale_up_cooldown }}
stampede_scale_down_cooldown = {{ drover_stampede_scale_down_cooldown }}
stampede_resource_headroom_factor = {{ drover_stampede_resource_headroom_factor }}
